# Copy to .env.production (gitignored) or: npm run env:sync-flatbase

CHATBOT_ENV=production
APP_URL=
OPS_APP_URL=
PLATFORM_API_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_OPS_APP_URL=

CF_ACCOUNT_ID=
# Token API: permiso Account → Billing → Read (Billable Usage API). Sync: desk:secrets:prod
CF_BILLING_API_TOKEN=
CF_ZONE_ID=
R2_STORAGE_ENDPOINT=
R2_STORAGE_REGION=
R2_STORAGE_ACCESS_KEY_ID=
R2_STORAGE_SECRET_ACCESS_KEY=

JWT_SECRET=
ENCRYPTION_KEY=
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_API_BASE_URL=
CREEM_PRODUCT_STARTER=
CREEM_PRODUCT_GROWTH=
CREEM_PRODUCT_BUSINESS=
CREEM_PRODUCT_CREDITS_25=
CREEM_PRODUCT_CREDITS_50=
CREEM_PRODUCT_CREDITS_100=

OPS_BOOTSTRAP_ADMIN_EMAILS=
OPS_BOOTSTRAP_PASSWORD=
DESK_FROM_EMAIL=
# Opcional: alertas de cliente nuevo activo (default contact@rekov.co)
DESK_ONBOARDING_NOTIFY_EMAIL=

# OAuth app Desk (infra). La hoja de cada cliente se elige en el panel tras “Conectar Google”.
SIGNUPS_OPEN=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=

# WORKERS_AI_CHAT_MODEL=@cf/zai-org/glm-5.3-flash
# WORKERS_AI_EMBEDDING_MODEL=@cf/baai/bge-m3
# EMBEDDING_DIMENSIONS=1024

D1_DATABASE_ID=
KV_TENANT_CACHE_ID=
KV_TENANT_CACHE_PREVIEW_ID=

# WasapFlow Bridge (Worker api-desk). Dashboard → API Credentials + Settings → Webhook Secret
WF_PARTNER_KEY=
WF_WEBHOOK_SECRET=

# Cloudflare Turnstile (checkout chat/tienda). Dashboard → Turnstile → Add site → copiar ambas claves.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
