LLM_REQUEST_TIMEOUT_MS = "{{LLM_REQUEST_TIMEOUT_MS_TEST}}"
LLM_STREAM_ENABLED = "{{LLM_STREAM_ENABLED_TEST}}"
AGENT_FLOW_TOOLS = "{{AGENT_FLOW_TOOLS_TEST}}"
