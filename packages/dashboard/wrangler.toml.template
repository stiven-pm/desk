name = "desk-dashboard"
compatibility_date = "2026-04-01"
compatibility_flags = ["nodejs_compat"]
main = ".open-next/worker.js"
assets = { directory = ".open-next/assets", binding = "ASSETS" }

[env.test]
name = "desk-dashboard-test"

[[env.test.routes]]
pattern = "{{DESK_APP_HOST_TEST}}"
custom_domain = true

[[routes]]
pattern = "{{DESK_APP_HOST_PROD}}"
custom_domain = true
