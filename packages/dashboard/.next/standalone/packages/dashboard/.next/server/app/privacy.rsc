10:["$","div",null,{"className":"legal-prose mt-10 space-y-8 [&_h2]:font-display [&_h2]:text-xl [&_h3]:mt-4 [&_h3]:font-medium [&_li]:text-[var(--muted)] [&_p]:text-[var(--muted)] [&_table]:mt-3 [&_table]:w-full [&_table]:text-sm [&_td]:border [&_td]:border-[var(--border)] [&_td]:p-2 [&_th]:border [&_th]:border-[var(--border)] [&_th]:bg-[var(--muted-bg)] [&_th]:p-2 [&_th]:text-left [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5","children":[["$","section",null,{"children":[["$","p",null,{"children":["Rekov Systems S.A.S."," (\"","Rekov","\", \"we\", \"us\") operates ","Desk",", a cloud software platform that lets business customers (\"Customers\" or \"tenants\") reply with AI assistance to their own customers (\"End Users\") via hosted web chat and storefront. This Privacy Policy explains how we collect, use, disclose, and retain personal information when you use"," ",["$","a",null,{"href":"https://desk.rekov.co","children":"https://desk.rekov.co"}],", our APIs, web chat, dashboard, billing, and related services (the \"Service\")."]}],["$","p",null,{"className":"mt-3","children":[["$","strong",null,{"children":"Two roles."}]," For account, billing, and platform data, we are the data controller. For conversation content, uploaded files, and data processed on a Customer's instructions, we act as a processor/service provider on behalf of that Customer. Customers must provide their own privacy notice to End Users and obtain any required consent (including for automated messaging and AI)."]}]]}],["$","section",null,{"id":"collect","children":[["$","h2",null,{"children":"Personal information we collect"}],["$","h3",null,{"children":"Information you provide"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Account data:"}]," name, email, organization name, password (stored as a one-way hash), team invitations, role assignments."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Billing data:"}]," subscription plan, payment history, tax location where collected by our payment processor. We do not store full payment card numbers on our servers."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Customer content:"}]," bot instructions, knowledge-base documents, PDFs, images, videos (when uploaded), API/MCP integration settings, webhook URLs, and encrypted integration credentials."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Communications:"}]," support requests, security reports, and email you send us."]}]]}],["$","h3",null,{"children":"End User data (processed for Customers)"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Identifiers:"}]," visitor session id; phone or email if provided."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Messages:"}]," message text, optional attachments, automated replies, conversation metadata (timestamps, delivery status, assistant identifier)."]}]]}],["$","h3",null,{"children":"Automatic collection (dashboard & marketing site)"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Device and usage data:"}]," pages viewed, referrers, cookies or similar technologies on our marketing pages and authenticated dashboard (see"," ",["$","a",null,{"href":"/legal/cookies","children":"Cookie Notice"}],")."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Logs:"}]," API request metadata, error traces, audit events for security and billing metering."]}]]}],["$","h3",null,{"id":"label","children":"Privacy nutrition label (summary)"}],["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Category"}],["$","th",null,{"children":"Examples"}],["$","th",null,{"children":"Sold?"}],["$","th",null,{"children":"Shared for service?"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Identifiers"}],"$L16","$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c"]}]]}],"$L1d"]}],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}]
