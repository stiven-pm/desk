1d:["$","p",null,{"className":"mt-3","children":["We do ",["$","strong",null,{"children":"not"}]," sell personal information. We do ",["$","strong",null,{"children":"not"}]," use Customer conversation content or uploaded documents to train our own or third-party foundation models. Inference providers process content only to deliver the Service for that request."]}]
1e:["$","section",null,{"id":"use","children":[["$","h2",null,{"children":"How we use personal information"}],["$","ul",null,{"children":[["$","li",null,{"children":"Provide, secure, and improve the Service (hosting, multi-tenant isolation, metering, support)."}],["$","li",null,{"children":"Generate AI-assisted replies and retrieval over Customer-approved knowledge."}],["$","li",null,{"children":"Process subscriptions and wallet top-ups through our payment partner."}],["$","li",null,{"children":"Detect abuse, fraud, and violations of our Terms."}],["$","li",null,{"children":"Comply with law and respond to lawful requests."}],["$","li",null,{"children":"Send service and security communications; marketing only with consent or where permitted."}]]}],["$","p",null,{"className":"mt-3","children":[["$","strong",null,{"children":"Legal bases (EEA/UK):"}]," contract performance, legitimate interests (security, product improvement), consent where required (e.g., non-essential cookies), and legal obligation."]}]]}]
1f:["$","section",null,{"id":"chat-web","children":[["$","h2",null,{"children":"Web chat"}],["$","p",null,{"children":["When a Customer publishes chat or storefront on ","Desk",", we process messages and data End Users submit to generate the automated replies the Customer configures. The Customer is responsible for privacy notices and consent required in their jurisdiction."]}]]}]
20:["$","section",null,{"id":"ai","children":[["$","h2",null,{"children":"Artificial intelligence (FTC-style disclosure)"}],["$","p",null,{"children":["End Users interacting with a Customer's bot may receive ",["$","strong",null,{"children":"automated"}]," responses generated by large language models and retrieval systems. Outputs can be inaccurate or incomplete. Customers should disclose automated interaction where required (including U.S. FTC guidance on AI and bots). Sensitive decisions (payments, legal, medical) should involve human review when appropriate."]}],["$","p",null,{"className":"mt-3","children":"Uploaded images, PDFs, and videos may be parsed or transcribed to extract text for search and replies; binary files remain stored under the Customer's retention policy."}]]}]
21:["$","section",null,{"id":"share","children":[["$","h2",null,{"children":"How we share information"}],["$","p",null,{"children":"We share personal information only with:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Subprocessors"}]," that help us run the Service, including Cloudflare (hosting, D1, R2, Workers AI, Vectorize, email), payment processor Creem (subscriptions and wallet), IP geolocation providers (ip.guide, ipquery.io) for dashboard sign-in, and transactional email when enabled."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Customers' chosen integrations"}]," (APIs, webhooks, MCP servers) when the Customer configures them."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Professional advisers"}]," and authorities when required by law or to protect rights and safety."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Business transfers"}]," in connection with merger, acquisition, or asset sale, with notice where required."]}]]}],["$","p",null,{"className":"mt-3","children":["We do ",["$","strong",null,{"children":"not"}]," sell Platform Data or share it with third parties for advertising. We use contracted subprocessors only to operate the Service."]}],["$","p",null,{"className":"mt-3","id":"authorities","children":[["$","strong",null,{"children":"Government requests."}]," We review the legality of law-enforcement and public-authority requests, disclose only the minimum necessary information, document requests and responses, and may challenge requests we believe are unlawful, unless prohibited by law."]}],["$","p",null,{"className":"mt-3","children":["A current subprocessor list is available on request at ","privacy@rekov.co",". Material changes will be notified to active account administrators."]}]]}]
22:["$","section",null,{"id":"retention","children":[["$","h2",null,{"children":"Retention"}],["$","p",null,{"children":["We retain account data while the subscription is active and for a reasonable period afterward for legal, tax, and dispute resolution. Conversation retention follows the Customer's plan limits (published on our pricing page). Backups may persist for a limited window after deletion. Customers can export or delete organization data from the dashboard where features are available, or request assistance at ","privacy@rekov.co","."]}]]}]
23:["$","section",null,{"id":"security","children":[["$","h2",null,{"children":"Security"}],["$","ul",null,{"children":[["$","li",null,{"children":"TLS (HTTPS) for data in transit between clients and our edge."}],["$","li",null,{"children":"Logical multi-tenant isolation per organization; role-based access inside each tenant."}],["$","li",null,{"children":"Passwords hashed; API keys and integration secrets encrypted at rest."}],["$","li",null,{"children":"Operational logging, monitoring, and rate limiting to mitigate abuse."}],["$","li",null,{"children":"Backup and recovery procedures aligned with our cloud provider; no method is 100% secure."}]]}],["$","p",null,{"className":"mt-3","children":["Report vulnerabilities to ","security@rekov.co",". If we confirm a breach affecting personal data, we will notify Customers and regulators as required by applicable law."]}]]}]
24:["$","section",null,{"id":"rights","children":[["$","h2",null,{"children":"Your privacy rights"}],["$","p",null,{"children":["Depending on your location, you may have rights to access, correct, delete, restrict, port, or object to processing, and to withdraw consent. California residents have rights under the CCPA/CPRA (know, delete, correct, opt out of sale/sharing — we do not sell). Colombian residents may exercise rights under Law 1581 of 2012 by writing to ","privacy@rekov.co","."]}],["$","p",null,{"className":"mt-3","children":[["$","strong",null,{"children":"End Users:"}]," contact the business that operates the chat first. We will assist the Customer in fulfilling requests where we process data on their behalf."]}],["$","p",null,{"className":"mt-3","children":["EU/UK residents may lodge a complaint with their supervisory authority. Our contact for GDPR requests:"," ","privacy@rekov.co","."]}]]}]
25:["$","section",null,{"id":"international","children":[["$","h2",null,{"children":"International transfers"}],["$","p",null,{"children":["We are established in ","Colombia",". Data may be processed in the United States and other countries where our subprocessors operate. We rely on appropriate safeguards (such as Standard Contractual Clauses where applicable) and vendor security commitments for cross-border transfers."]}]]}]
26:["$","section",null,{"id":"children","children":[["$","h2",null,{"children":"Children"}],["$","p",null,{"children":"The Service is not directed to children under 16 (or under 13 in the U.S. without parental consent). Customers must not deploy the Service to collect children's data unlawfully."}]]}]
27:["$","section",null,{"id":"changes","children":[["$","h2",null,{"children":"Changes"}],["$","p",null,{"children":"We may update this Policy. We will post the new date and, for material changes, notify account administrators by email or in-product notice."}]]}]
