{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/chat/[slug]",
      "regex": "^/chat/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/chat/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/bots/[botId]",
      "regex": "^/dashboard/bots/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbotId": "nxtPbotId"
      },
      "namedRegex": "^/dashboard/bots/(?<nxtPbotId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/o/[ref]",
      "regex": "^/o/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPref": "nxtPref"
      },
      "namedRegex": "^/o/(?<nxtPref>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[slug]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
