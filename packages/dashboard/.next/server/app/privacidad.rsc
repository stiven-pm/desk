[["$","strong",null,{"children":"Contenido del cliente:"}]," instrucciones del bot, PDFs, imágenes, videos (si los subes), integraciones API/MCP, credenciales cifradas."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Usuarios finales:"}]," identificador de sesión, teléfono o correo si lo dejan, mensajes, adjuntos y metadatos de conversación (fecha, estado de entrega)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Automático:"}]," cookies en sitio de marketing y panel, logs técnicos y de auditoría (ver"," ",["$","a",null,{"href":"/legal/cookies","children":"aviso de cookies"}],")."]}]]}],["$","h3",null,{"id":"etiqueta","children":"Etiqueta resumen de privacidad"}],["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Categoría"}],["$","th",null,{"children":"Ejemplos"}],["$","th",null,{"children":"¿Vendemos?"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Identificadores"}],["$","td",null,{"children":"Correo, org, ID de visitante"}],["$","td",null,{"children":"No"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Contenido"}],["$","td",null,{"children":"Chat, PDF, imagen, video"}],["$","td",null,{"children":"No"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Técnicos"}],["$","td",null,{"children":"IP, logs, cookies"}],["$","td",null,{"children":"No"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Inferencias"}],["$","td",null,{"children":"Embeddings, respuestas IA (sin entrenar modelos públicos)"}],["$","td",null,{"children":"No"}]]}]]}]]}],["$","p",null,{"className":"mt-3","children":"No vendemos datos. No usamos conversaciones ni documentos para entrenar modelos propios ni de terceros."}]]}],["$","section",null,{"id":"uso","children":[["$","h2",null,{"children":"Finalidades"}],["$","p",null,{"children":"Prestar y asegurar el Servicio, generar respuestas asistidas por IA, facturar, preven