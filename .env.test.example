# Infra Desk (no es “tu Sheet” ni credenciales de cada cliente).
# Son el OAuth app de Rekov en Google Cloud / HubSpot / Shopify.
# Vacío = botones “Conectar” deshabilitados en Fuentes. Cada tenant conecta SU cuenta
# desde el panel; los tokens van cifrados en D1 por bot (no van aquí).
SIGNUPS_OPEN=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=

